import { ComboBox, Slider } from "std-widgets.slint";

export struct PrayerItem {
    name: string,
    arabic-name: string,
    time: string,
    enabled: bool,
    can-toggle: bool,
    is-next: bool,
}

component NavButton inherits Rectangle {
    in property <string> symbol;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 48px;
    border-radius: 10px;
    background: selected ? #28473d : nav-touch.has-hover ? #1c332c : transparent;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 12px;
        Text { text: root.symbol; color: root.selected ? #efd085 : #9fb8ae; font-size: 20px; vertical-alignment: center; width: 24px; horizontal-alignment: center; }
        Text { text: root.label; color: root.selected ? #fff8e8 : #b9cbc4; font-size: 14px; font-weight: root.selected ? 650 : 450; vertical-alignment: center; }
    }
    nav-touch := TouchArea { clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 44px; height: 24px; border-radius: 12px;
    background: !root.enabled ? #34433e : root.checked ? #d6ad5c : #3d514a;
    opacity: root.enabled ? 1 : 0.55;
    knob := Rectangle {
        x: root.checked ? 22px : 3px; y: 3px; width: 18px; height: 18px; border-radius: 9px;
        background: root.checked ? #173027 : #d8e1dd;
        animate x { duration: 130ms; easing: ease-in-out; }
    }
    toggle-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

component SoftButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 110px; height: 38px; border-radius: 9px;
    background: !root.enabled ? #263932 : root.primary
        ? (button-touch.pressed ? #bc9145 : button-touch.has-hover ? #e1bd70 : #d6ad5c)
        : (button-touch.pressed ? #294239 : button-touch.has-hover ? #315046 : #263f37);
    border-width: root.primary ? 0 : 1px; border-color: #3e5d52; opacity: root.enabled ? 1 : 0.55;
    Text { text: root.text; color: root.primary ? #14271f : #e6eee9; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    button-touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component SectionCard inherits Rectangle {
    background: #152821; border-radius: 16px; border-width: 1px; border-color: #274238;
}

component PrayerCard inherits Rectangle {
    in property <PrayerItem> data;
    in property <int> prayer-index;
    callback toggled(int, bool);
    height: 54px; border-radius: 12px;
    background: data.is-next ? #25463b : #172b24;
    border-width: 1px; border-color: data.is-next ? #8c743e : #294239;
    if data.is-next : Rectangle { x: 0; y: 10px; width: 3px; height: parent.height - 20px; border-radius: 2px; background: #e1bd70; }
    HorizontalLayout {
        padding-left: 18px; padding-right: 16px; spacing: 14px;
        VerticalLayout {
            alignment: center; spacing: 1px;
            Text { text: root.data.name; color: root.data.is-next ? #fff7e4 : #edf4f0; font-size: 14px; font-weight: 600; }
            Text { text: root.data.arabic-name; color: #91aaa0; font-size: 12px; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text { text: root.data.time; color: root.data.is-next ? #f0cf80 : #dce7e2; font-size: 18px; font-weight: 650; vertical-alignment: center; }
        if root.data.can-toggle : Toggle { checked: root.data.enabled; toggled(value) => { root.toggled(root.prayer-index, value); } }
        if !root.data.can-toggle : Text { text: "SUN"; color: #6f8b80; font-size: 10px; font-weight: 650; vertical-alignment: center; horizontal-alignment: center; width: 44px; }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 70px; background: transparent;
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 16px;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: root.title; color: #edf4f0; font-size: 14px; font-weight: 600; }
            Text { text: root.detail; color: #8fa79d; font-size: 12px; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Toggle { checked <=> root.checked; toggled(value) => { root.toggled(value); } }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <string> next-label: "Next prayer · loading";
    in property <bool> paused: false;
    icon: @image-url("../assets/icon.svg");
    tooltip: "AzanBoki · " + next-label;
    callback open-requested;
    callback toggle-paused;
    callback mute-hour;
    callback stop-audio;
    callback quit-requested;
    clicked => { root.open-requested(); }
    Menu {
        MenuItem { title: "Open AzanBoki"; activated => { root.open-requested(); } }
        MenuItem { title: root.next-label; enabled: false; }
        MenuSeparator { }
        MenuItem { title: root.paused ? "Resume Azan" : "Pause Azan"; activated => { root.toggle-paused(); } }
        MenuItem { title: "Mute for one hour"; activated => { root.mute-hour(); } }
        MenuItem { title: "Stop audio"; activated => { root.stop-audio(); } }
        MenuSeparator { }
        MenuItem { title: "Quit"; activated => { root.quit-requested(); } }
    }
}

export component MainWindow inherits Window {
    title: "AzanBoki";
    icon: @image-url("../assets/icon.svg");
    background: #0c1915;
    preferred-width: 1040px; preferred-height: 700px; min-width: 860px; min-height: 680px;

    in property <[PrayerItem]> prayers;
    in property <string> current-city: "Cairo, Egypt";
    in property <string> date-label: "";
    in property <string> next-prayer: "Fajr";
    in property <string> next-arabic: "الفجر";
    in property <string> next-time: "--:--";
    in property <string> countdown: "";
    in property <string> status-message: "Starting…";
    in property <[string]> country-options;
    in property <[string]> city-options;
    in-out property <int> country-index: 0;
    in-out property <int> city-index: 0;
    in property <[string]> method-options;
    in-out property <int> method-index: 0;
    in property <[string]> asr-options;
    in-out property <int> asr-index: 0;
    in property <[string]> high-latitude-options;
    in-out property <int> high-latitude-index: 0;
    in property <string> regular-audio-name: "Built-in Azan";
    in property <string> fajr-audio-name: "Uses regular Azan";
    in-out property <float> volume: 0.78;
    in-out property <bool> master-enabled: true;
    in-out property <bool> start-on-login: true;
    in-out property <bool> start-hidden: true;
    in-out property <int> page: 0;

    callback prayer-toggled(int, bool);
    callback country-selected(int);
    callback city-selected(int);
    callback method-selected(int);
    callback asr-selected(int);
    callback high-latitude-selected(int);
    callback choose-regular-audio;
    callback choose-fajr-audio;
    callback preview-regular;
    callback preview-fajr;
    callback stop-audio;
    callback volume-changed(float);
    callback master-toggled(bool);
    callback start-on-login-toggled(bool);
    callback start-hidden-toggled(bool);
    callback close-to-tray;

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 218px; background: #10221c;
            VerticalLayout {
                padding: 20px; spacing: 7px;
                Rectangle {
                    height: 74px; background: transparent;
                    HorizontalLayout {
                        spacing: 12px;
                        Image { source: @image-url("../assets/icon.svg"); width: 42px; height: 42px; image-fit: contain; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center; spacing: 1px;
                            Text { text: "AzanBoki"; color: #fff5dc; font-size: 18px; font-weight: 700; }
                            Text { text: "PRAYER COMPANION"; color: #779489; font-size: 9px; font-weight: 650; }
                        }
                    }
                }
                NavButton { symbol: "⌂"; label: "Today"; selected: root.page == 0; clicked => { root.page = 0; } }
                NavButton { symbol: "◎"; label: "Location"; selected: root.page == 1; clicked => { root.page = 1; } }
                NavButton { symbol: "♫"; label: "Muezzin & audio"; selected: root.page == 2; clicked => { root.page = 2; } }
                NavButton { symbol: "⚙"; label: "Settings"; selected: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 78px; border-radius: 12px; background: #162c24; border-width: 1px; border-color: #29463b;
                    VerticalLayout {
                        padding: 12px; spacing: 4px;
                        Text { text: "●  ACTIVE"; color: root.master-enabled ? #7fc99e : #c79d75; font-size: 10px; font-weight: 700; }
                        Text { text: root.current-city; color: #dbe8e2; font-size: 12px; overflow: elide; }
                        Text { text: root.status-message; color: #78958a; font-size: 9px; overflow: elide; }
                    }
                }
            }
        }

        Rectangle {
            background: @linear-gradient(145deg, #10231d 0%, #0c1915 62%, #15251d 100%);
            horizontal-stretch: 1;

            if root.page == 0 : Rectangle {
                background: transparent;
                VerticalLayout {
                    padding-left: 34px; padding-right: 34px; padding-top: 27px; padding-bottom: 22px; spacing: 16px;
                    HorizontalLayout {
                        height: 48px;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Assalamu alaikum"; color: #f2f6f3; font-size: 21px; font-weight: 650; }
                            Text { text: root.current-city + "  ·  " + root.date-label; color: #87a399; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        SoftButton { text: "Hide to tray"; clicked => { root.close-to-tray(); } }
                    }
                    SectionCard {
                        height: 178px; background: @linear-gradient(105deg, #21483b 0%, #17352c 58%, #5a4927 145%); border-color: #476451;
                        HorizontalLayout {
                            padding-left: 28px; padding-right: 28px; spacing: 20px;
                            VerticalLayout {
                                alignment: center; spacing: 5px;
                                Text { text: "NEXT"; color: #a7beb4; font-size: 10px; font-weight: 700; }
                                Text { text: root.next-prayer; color: #fff5dc; font-size: 35px; font-weight: 700; }
                                Text { text: root.next-arabic; color: #d6ba78; font-size: 18px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            VerticalLayout {
                                alignment: center; spacing: 5px;
                                Text { text: root.next-time; color: #f4d58c; font-size: 40px; font-weight: 650; horizontal-alignment: right; }
                                Text { text: "in " + root.countdown; color: #b5c8c0; font-size: 13px; horizontal-alignment: right; }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 7px;
                        for prayer[index] in root.prayers : PrayerCard { data: prayer; prayer-index: index; toggled(i, value) => { root.prayer-toggled(i, value); } }
                    }
                }
            }

            if root.page == 1 : Rectangle {
                background: transparent;
                VerticalLayout {
                    padding: 36px; spacing: 20px;
                    Text { text: "Location & calculation"; color: #f4f7f5; font-size: 25px; font-weight: 700; }
                    Text { text: "Choose where you are. Times are calculated locally and continue working offline."; color: #91a99f; font-size: 13px; }
                    SectionCard {
                        height: 230px;
                        VerticalLayout {
                            padding: 24px; spacing: 10px;
                            Text { text: "COUNTRY"; color: #819e92; font-size: 10px; font-weight: 700; }
                            country-box := ComboBox { model: root.country-options; current-index <=> root.country-index; selected(value) => { root.country-selected(country-box.current-index); } }
                            Rectangle { height: 6px; background: transparent; }
                            Text { text: "CITY"; color: #819e92; font-size: 10px; font-weight: 700; }
                            city-box := ComboBox { model: root.city-options; current-index <=> root.city-index; selected(value) => { root.city-selected(city-box.current-index); } }
                            Text { text: "Current: " + root.current-city; color: #d8e5df; font-size: 12px; }
                        }
                    }
                    SectionCard {
                        height: 245px;
                        VerticalLayout {
                            padding: 24px; spacing: 9px;
                            Text { text: "CALCULATION METHOD"; color: #819e92; font-size: 10px; font-weight: 700; }
                            method-box := ComboBox { model: root.method-options; current-index <=> root.method-index; selected(value) => { root.method-selected(method-box.current-index); } }
                            Text { text: "ASR JURISTIC METHOD"; color: #819e92; font-size: 10px; font-weight: 700; }
                            asr-box := ComboBox { model: root.asr-options; current-index <=> root.asr-index; selected(value) => { root.asr-selected(asr-box.current-index); } }
                            Text { text: "HIGH-LATITUDE RULE"; color: #819e92; font-size: 10px; font-weight: 700; }
                            latitude-box := ComboBox { model: root.high-latitude-options; current-index <=> root.high-latitude-index; selected(value) => { root.high-latitude-selected(latitude-box.current-index); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            if root.page == 2 : Rectangle {
                background: transparent;
                VerticalLayout {
                    padding: 36px; spacing: 20px;
                    Text { text: "Muezzin & audio"; color: #f4f7f5; font-size: 25px; font-weight: 700; }
                    Text { text: "A public-domain Azan is included. You can choose recordings you have permission to use."; color: #91a99f; font-size: 13px; }
                    SectionCard {
                        height: 156px;
                        HorizontalLayout {
                            padding: 24px; spacing: 20px;
                            VerticalLayout {
                                alignment: center; spacing: 7px;
                                Text { text: "REGULAR AZAN"; color: #819e92; font-size: 10px; font-weight: 700; }
                                Text { text: root.regular-audio-name; color: #f2f6f3; font-size: 18px; font-weight: 650; overflow: elide; }
                                Text { text: "Dhuhr · Asr · Maghrib · Isha"; color: #839d92; font-size: 11px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            VerticalLayout {
                                alignment: center; spacing: 9px;
                                SoftButton { text: "Preview"; primary: true; clicked => { root.preview-regular(); } }
                                SoftButton { text: "Choose file"; clicked => { root.choose-regular-audio(); } }
                            }
                        }
                    }
                    SectionCard {
                        height: 156px;
                        HorizontalLayout {
                            padding: 24px; spacing: 20px;
                            VerticalLayout {
                                alignment: center; spacing: 7px;
                                Text { text: "FAJR AZAN"; color: #819e92; font-size: 10px; font-weight: 700; }
                                Text { text: root.fajr-audio-name; color: #f2f6f3; font-size: 18px; font-weight: 650; overflow: elide; }
                                Text { text: "Choose a Fajr-specific recording, or use the regular Azan."; color: #839d92; font-size: 11px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            VerticalLayout {
                                alignment: center; spacing: 9px;
                                SoftButton { text: "Preview"; primary: true; clicked => { root.preview-fajr(); } }
                                SoftButton { text: "Choose file"; clicked => { root.choose-fajr-audio(); } }
                            }
                        }
                    }
                    SectionCard {
                        height: 96px;
                        HorizontalLayout {
                            padding-left: 24px; padding-right: 24px; spacing: 18px;
                            Text { text: "Volume"; color: #e9f0ec; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                            Slider { minimum: 0; maximum: 1; step: 0.01; value <=> root.volume; released => { root.volume-changed(self.value); } }
                            Text { text: round(root.volume * 100) + "%"; color: #d9bd79; font-size: 13px; width: 44px; vertical-alignment: center; horizontal-alignment: right; }
                            SoftButton { text: "Stop"; clicked => { root.stop-audio(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            if root.page == 3 : Rectangle {
                background: transparent;
                VerticalLayout {
                    padding: 36px; spacing: 20px;
                    Text { text: "Settings"; color: #f4f7f5; font-size: 25px; font-weight: 700; }
                    Text { text: "AzanBoki stays in your user session so it can reliably reach your speakers."; color: #91a99f; font-size: 13px; }
                    SectionCard {
                        height: 212px;
                        VerticalLayout {
                            spacing: 0;
                            SettingRow { title: "Azan playback"; detail: "Master switch for all five daily prayers"; checked <=> root.master-enabled; toggled(value) => { root.master-toggled(value); } }
                            Rectangle { height: 1px; background: #294239; }
                            SettingRow { title: "Start when I log in"; detail: "Runs as a lightweight tray app, not a system service"; checked <=> root.start-on-login; toggled(value) => { root.start-on-login-toggled(value); } }
                            Rectangle { height: 1px; background: #294239; }
                            SettingRow { title: "Start hidden"; detail: "Open directly in the tray after login"; checked <=> root.start-hidden; toggled(value) => { root.start-hidden-toggled(value); } }
                        }
                    }
                    SectionCard {
                        height: 165px;
                        VerticalLayout {
                            padding: 22px; spacing: 7px;
                            Text { text: "ABOUT"; color: #819e92; font-size: 10px; font-weight: 700; }
                            Text { text: "AzanBoki 0.1.0"; color: #f1f5f2; font-size: 17px; font-weight: 650; }
                            Text { text: "Prayer times are calculated offline. The scheduler refreshes on startup, after location changes, and at 02:00 local time."; color: #9bb0a7; font-size: 12px; wrap: word-wrap; }
                            Text { text: "Built-in recording: “Beautiful adhan” by Adam-synagda · CC0 1.0"; color: #c7ad70; font-size: 11px; }
                            Text { text: "Interface powered by Slint · application licensed MIT"; color: #728d82; font-size: 10px; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }
}
